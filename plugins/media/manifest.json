{
  "id": "com.shishir.cyberdeck.media",
  "name": "Media Controls",
  "apiVersion": "1.0",
  "permissions": {
    "categories": ["media"],
    "network": "none",
    "filesystem": "none"
  },
  "contributes": {
    "states": ["media.nowplaying", "media.playing"],
    "actions": [
      {"id": "media.transport.playPause", "label": "Play/Pause", "category": "media"},
      {"id": "media.transport.next", "label": "Next Track", "category": "media"},
      {"id": "media.transport.previous", "label": "Previous Track", "category": "media"},
      {"id": "media.screenshot", "label": "Screenshot", "category": "media"},
      {"id": "media.record", "label": "Record", "category": "media"},
      {"id": "media.cast", "label": "Cast", "category": "media"},
      {"id": "media.gamebar", "label": "Game Bar", "category": "media"}
    ]
  }
}
