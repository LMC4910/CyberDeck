{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdeck.shishir.com/schemas/control-plane/events/file-opened.schema.json",
  "title": "FileOpened Event",
  "description": "IDE-internal: a document/file opened in an editor. No engine topic. CD-114.",
  "type": "object",
  "required": [
    "path"
  ],
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "integer",
      "description": "unix ms"
    }
  }
}
