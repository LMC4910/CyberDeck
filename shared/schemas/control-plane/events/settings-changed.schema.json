{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdeck.shishir.com/schemas/control-plane/events/settings-changed.schema.json",
  "title": "SettingsChanged Event",
  "description": "A merged-view config value changed (matches CD-109 SettingsChanged delta shape). No engine topic. CD-114.",
  "type": "object",
  "required": [
    "area",
    "path"
  ],
  "additionalProperties": false,
  "properties": {
    "area": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "previous": {},
    "layer": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    }
  }
}
