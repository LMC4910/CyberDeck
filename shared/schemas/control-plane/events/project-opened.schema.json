{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdeck.shishir.com/schemas/control-plane/events/project-opened.schema.json",
  "title": "ProjectOpened Event",
  "description": "Emitted when a project document is opened (engine bridge: session.opened). CD-114.",
  "type": "object",
  "required": [
    "projectId"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "ts": {
      "type": "integer",
      "description": "unix ms"
    }
  }
}
