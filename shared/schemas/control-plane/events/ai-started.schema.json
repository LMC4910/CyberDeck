{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdeck.shishir.com/schemas/control-plane/events/ai-started.schema.json",
  "title": "AIStarted Event",
  "description": "An AI thread/completion started (flag aiProviders). CD-114.",
  "type": "object",
  "required": [
    "threadId"
  ],
  "additionalProperties": false,
  "properties": {
    "threadId": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "integer",
      "description": "unix ms"
    }
  }
}
