{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdeck.shishir.com/schemas/control-plane/events/notification-received.schema.json",
  "title": "NotificationReceived Event",
  "description": "A notification was raised (feeds the Notification Store projection). CD-114.",
  "type": "object",
  "required": [
    "id",
    "level"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "info",
        "warn",
        "error"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "ts": {
      "type": "integer",
      "description": "unix ms"
    }
  }
}
