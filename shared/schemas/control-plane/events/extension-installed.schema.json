{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdeck.shishir.com/schemas/control-plane/events/extension-installed.schema.json",
  "title": "ExtensionInstalled Event",
  "description": "An extension/plugin was installed/activated (engine bridge: plugin.started). CD-114.",
  "type": "object",
  "required": [
    "extensionId"
  ],
  "additionalProperties": false,
  "properties": {
    "extensionId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "ts": {
      "type": "integer",
      "description": "unix ms"
    }
  }
}
