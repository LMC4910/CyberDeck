{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdeck.shishir.com/schemas/widget.schema.json",
  "title": "CyberDeck Widget-Type Descriptor",
  "description": "A widget type contributed to the widget registry (TRD 2B §3.2). acceptsStateKinds lets the designer offer only compatible states when binding; gestures declares the interaction slots the type exposes. Enforced in code by PROJ-161.",
  "type": "object",
  "required": ["type", "label"],
  "additionalProperties": false,
  "properties": {
    "type": { "type": "string", "minLength": 1, "description": "widget type id, e.g. gauge.circular" },
    "label": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "acceptsStateKinds": {
      "type": "array",
      "items": { "type": "string", "enum": ["scalar", "text", "boolean", "enum", "series"] }
    },
    "configSchema": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "default": {}
        }
      }
    },
    "gestures": { "type": "array", "items": { "type": "string" } }
  }
}
